{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toon-studio-contract-v2",
  "$defs": {
    "ActionInput": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "approve_story",
            "approve_format",
            "approve_storyboard",
            "revise_story",
            "revise_storyboard",
            "reject",
            "retry"
          ],
          "title": "Action",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "feedback": {
          "default": "",
          "maxLength": 5000,
          "title": "Feedback",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "action",
        "expected_revision"
      ],
      "title": "ActionInput",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "gate": {
          "enum": [
            "G1",
            "FORMAT",
            "TECHNICAL_BOARD"
          ],
          "title": "Gate",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "actor": {
          "const": "human",
          "title": "Actor",
          "type": "string"
        },
        "scope": {
          "const": "synthetic_technical_review",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "gate",
        "project_id",
        "run_id",
        "artifact_id",
        "version",
        "at",
        "actor",
        "scope"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ArtifactVersion": {
