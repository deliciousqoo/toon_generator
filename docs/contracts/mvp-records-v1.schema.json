{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:toon-generator:contracts:mvp-records:1.0.0",
  "title": "Toon Generator local MVP records",
  "description": "Minimum machine-readable record contracts for synthetic Stage 01-05 validation. Detailed creative and rights decisions remain governed by the stage specifications and human approval gates.",
  "oneOf": [
    { "$ref": "#/$defs/projectBrief" },
    { "$ref": "#/$defs/referenceResearch" },
    { "$ref": "#/$defs/characterPackage" },
    { "$ref": "#/$defs/accountStrategy" },
    { "$ref": "#/$defs/episodeBrief" },
    { "$ref": "#/$defs/storyboardPackage" },
    { "$ref": "#/$defs/imageGenerationRunManifest" },
    { "$ref": "#/$defs/assetRecord" },
    { "$ref": "#/$defs/reviewDecision" },
    { "$ref": "#/$defs/auditEvent" }
  ],
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["artifact_id", "version", "project_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "project_id": { "type": "string", "minLength": 1 },
        "content_id": { "type": "string", "minLength": 1 },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rework", "rejected", "blocked"] },
        "gate": { "type": "string" },
        "decision": { "enum": ["approved", "rework", "rejected", "pending"] },
        "review_decision_id": { "type": "string" },
        "approver": { "type": "string" },
        "approved_version": { "type": "string" },
        "decision_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not_run", "passed", "warning", "failed", "blocked"] },
        "checked_at": { "type": "string", "format": "date-time" },
        "checks": { "type": "array", "items": { "type": "object" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "envelope": {
      "type": "object",
      "required": [
        "artifact_type", "artifact_id", "version", "schema_id", "schema_version",
        "project_id", "state", "created_at", "created_by", "owner",
        "source_artifact_refs", "approval", "validation", "provenance",
        "unresolved_risks", "next_consumer"
      ],
      "properties": {
        "artifact_type": { "type": "string" },
        "artifact_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "schema_id": { "const": "urn:toon-generator:contracts:mvp-records" },
        "schema_version": { "const": "1.0.0" },
        "project_id": { "type": "string", "minLength": 1 },
        "content_id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["draft", "candidate", "approved", "rework", "superseded", "blocked", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "source_artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "approval": { "$ref": "#/$defs/approval" },
        "validation": { "$ref": "#/$defs/validation" },
        "provenance": { "type": "object" },
        "unresolved_risks": { "type": "array", "items": { "type": "string" } },
        "next_consumer": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "projectBrief": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "artifact_type": { "const": "project_brief" },
            "brief": {
              "type": "object",
              "required": ["account_or_series_direction", "primary_character", "audience", "tone", "supported_formats", "exclusions", "reference_questions", "constraints"],
              "properties": {
                "account_or_series_direction": { "type": "string" },
                "primary_character": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "enum": ["setup_required", "defined"] },
                    "character_id": { "type": "string" },
                    "description": { "type": "string" }
                  },
                  "additionalProperties": true
                },
                "audience": { "type": "array", "items": { "type": "string" } },
                "tone": { "type": "array", "items": { "type": "string" } },
                "supported_formats": { "type": "array", "items": { "type": "string" } },
                "exclusions": { "type": "array", "items": { "type": "string" } },
                "reference_questions": { "type": "array", "items": { "type": "string" } },
                "constraints": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": true
            }
          },
          "required": ["artifact_type", "brief"]
        }
      ]
    },
    "referenceResearch": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "artifact_type": { "const": "reference_research" },
            "scope": { "type": "object" },
            "references": { "type": "array", "items": { "type": "object", "required": ["reference_id", "source", "use_classification", "not_to_copy"], "properties": { "reference_id": { "type": "string" }, "source": { "type": "object" }, "use_classification": { "type": "string" }, "not_to_copy": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true } },
            "patterns": { "type": "array", "items": { "type": "object" } }
          },
          "required": ["artifact_type", "scope", "references", "patterns"]
        }
      ]
    },
    "characterPackage": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "artifact_type": { "const": "character_package" },
            "character_id": { "type": "string", "minLength": 1 },
            "identity": { "type": "object", "required": ["invariants", "controlled_variations", "forbidden_traits"], "properties": { "invariants": { "type": "array", "items": { "type": "object" } }, "controlled_variations": { "type": "array" }, "forbidden_traits": { "type": "array" } }, "additionalProperties": true },
            "behavior_and_voice": { "type": "object" },
            "sheet": { "type": "object" },
            "rights_and_sources": { "type": "object" }
          },
          "required": ["artifact_type", "character_id", "identity", "behavior_and_voice", "sheet", "rights_and_sources"]
        }
      ]
    },
    "accountStrategy": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "artifact_type": { "const": "account_strategy" },
            "account_id": { "type": "string", "minLength": 1 },
            "account_direction": { "type": "object" },
            "content_pillars": { "type": "array", "items": { "type": "object" } },
            "selected_series": { "type": "object" },
            "series": { "type": "array", "items": { "type": "object" } },
            "editorial_constraints": { "type": "object" },
            "experiments": { "type": "array", "items": { "type": "object" } }
          },
          "required": ["artifact_type", "account_id", "account_direction", "content_pillars", "selected_series", "series", "editorial_constraints", "experiments"]
        }
      ]
    },
    "episodeBrief": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "artifact_type": { "const": "episode_brief" },
            "content_id": { "type": "string", "minLength": 1 },
            "input": {
              "type": "object",
              "required": ["mode", "supplied_material", "requested_edit_scope"],
              "properties": {
                "mode": { "enum": ["short_topic", "developed_story"] },
                "supplied_material": { "type": "string" },
                "requested_edit_scope": { "type": "array", "items": { "type": "string" } },
                "requested_format": { "type": ["string", "null"] },
                "episode_constraints": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": true
            },
            "unresolved_questions": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["artifact_type", "content_id", "input", "unresolved_questions"]
        }
      ]
    },
    "storyboardPackage": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "artifact_type": { "const": "storyboard_package" },
            "content_id": { "type": "string", "minLength": 1 },
            "visual_detail": { "type": "object", "required": ["default_level"], "properties": { "default_level": { "const": "level_1_beat_thumbnails" }, "unit_overrides": { "type": "array", "items": { "type": "object" } } }, "additionalProperties": true },
            "story": {
              "type": "object",
              "required": ["structure", "text_objects"],
              "properties": {
                "structure": {
                  "type": "object",
                  "required": ["beats"],
                  "properties": {
                    "beats": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["beat_id", "order", "action"],
                        "properties": {
                          "beat_id": { "type": "string" },
                          "order": { "type": "integer", "minimum": 1 },
                          "action": { "type": "string" }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                },
                "text_objects": { "type": "array", "items": { "type": "object" } }
              },
              "additionalProperties": true
            },
            "storyboard": {
              "type": "object",
              "required": ["units"],
              "properties": {
                "units": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["unit_id", "order", "action"],
                    "properties": {
                      "unit_id": { "type": "string" },
                      "order": { "type": "integer", "minimum": 1 },
                      "action": { "type": "string" },
                      "beat_id": { "type": "string" }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            },
            "content_scope": { "type": "object" },
            "source_versions": { "type": "object" }
          },
          "required": ["artifact_type", "content_id", "visual_detail", "story", "storyboard", "content_scope", "source_versions"]
        }
      ]
    },
    "imageGenerationRunManifest": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "artifact_type": { "const": "image_generation_run_manifest" },
            "content_id": { "type": "string", "minLength": 1 },
            "run": { "type": "object", "required": ["run_id", "purpose", "unit_ids", "status"], "properties": { "run_id": { "type": "string" }, "purpose": { "type": "string" }, "unit_ids": { "type": "array", "items": { "type": "string" } }, "status": { "type": "string" } }, "additionalProperties": true },
            "inputs": { "type": "object", "required": ["storyboard_package"], "properties": { "storyboard_package": { "type": "object", "required": ["artifact_id", "version", "project_id", "content_id", "approval_gate", "approval_status"], "properties": { "artifact_id": { "type": "string" }, "version": { "type": "string" }, "project_id": { "type": "string" }, "content_id": { "type": "string" }, "approval_gate": { "const": "G2" }, "approval_status": { "const": "approved" } }, "additionalProperties": true } }, "additionalProperties": true },
            "outputs": { "type": "array", "items": { "type": "object", "required": ["output_id", "role", "asset_id", "status"], "properties": { "output_id": { "type": "string" }, "role": { "enum": ["per_unit_candidate", "episode_preview"] }, "asset_id": { "type": "string" }, "unit_id": { "type": "string" }, "status": { "type": "string" } }, "additionalProperties": true } },
            "review_package": { "type": "object", "required": ["per_unit_candidate_sets", "composed_preview_asset_id", "selected_output_ids"], "properties": { "per_unit_candidate_sets": { "type": "array", "items": { "type": "object", "required": ["unit_id", "candidate_output_ids"], "properties": { "unit_id": { "type": "string" }, "candidate_output_ids": { "type": "array", "items": { "type": "string" } }, "selected_output_id": { "type": ["string", "null"] } } } }, "composed_preview_asset_id": { "type": "string" }, "selected_output_ids": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true },
            "adapter": { "type": "object", "required": ["kind", "synthetic"], "properties": { "kind": { "type": "string", "minLength": 1 }, "synthetic": { "type": "boolean" } }, "additionalProperties": true }
          },
          "required": ["artifact_type", "content_id", "run", "inputs", "outputs", "review_package", "adapter"]
        }
      ]
    },
    "assetRecord": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "artifact_type": { "const": "asset_record" },
            "asset_id": { "type": "string", "minLength": 1 },
            "media_type": { "type": "string", "minLength": 1 },
            "byte_size": { "type": "integer", "minimum": 0 },
            "storage_key": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "owner_artifact_ref": { "$ref": "#/$defs/sourceRef" }
          },
          "required": ["artifact_type", "asset_id", "media_type", "byte_size", "storage_key", "sha256", "owner_artifact_ref"]
        }
      ]
    },
    "reviewDecision": {
      "type": "object",
      "required": ["record_type", "review_decision_id", "project_id", "gate", "artifact_ref", "actor", "decision", "decided_at", "next_state"],
      "properties": {
        "record_type": { "const": "review_decision" },
        "review_decision_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "content_id": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 },
        "artifact_ref": { "$ref": "#/$defs/sourceRef" },
        "actor": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approved", "rework", "rejected"] },
        "decided_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "next_state": { "type": "string" }
      },
      "additionalProperties": true
    },
    "auditEvent": {
      "type": "object",
      "required": ["record_type", "event_id", "project_id", "actor", "action", "occurred_at", "scope", "result"],
      "properties": {
        "record_type": { "const": "audit_event" },
        "event_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "content_id": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "action": { "enum": ["create", "edit", "version", "select", "regenerate", "review", "export", "restore", "failure", "retry"] },
        "occurred_at": { "type": "string", "format": "date-time" },
        "scope": { "type": "object", "required": ["record_type", "record_id"], "properties": { "record_type": { "type": "string" }, "record_id": { "type": "string" }, "version": { "type": "string" } } },
        "result": { "type": "string" },
        "before_ref": { "$ref": "#/$defs/sourceRef" },
        "after_ref": { "$ref": "#/$defs/sourceRef" }
      },
      "additionalProperties": true
    }
  }
}
